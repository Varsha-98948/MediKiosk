# Database (PostgreSQL / Supabase / Neon / AWS RDS)
DATABASE_URL="postgresql://postgres:password@localhost:5432/medikiosk?schema=public"

# Authentication
JWT_SECRET="replace-with-a-long-random-secret-key-in-production"

# Supabase Storage / S3-Compatible Object Storage
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="medical-documents"

# Gemini AI API Key
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Application Base URL
APP_URL="http://localhost:3000"

# FastAPI Backend URL (exposed to browser — must match CORS allowed origins in backend/app/main.py)
# Set to empty string to fall back to Next.js API routes (development without FastAPI)
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"
